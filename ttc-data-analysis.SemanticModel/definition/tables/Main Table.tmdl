table 'Main Table'
	lineageTag: 1a2a5e91-09c2-4f7b-9a9a-102da7ff01d6

	measure 'Most Common Delay Description' =
			
			VAR TopCodeTable =
			    TOPN(
			        1,
			        VALUES('Main Table'[Code]),
			        CALCULATE(COUNTROWS('Main Table')),
			        DESC
			    )
			VAR TopCodeVal =
			    MAXX(TopCodeTable, 'Main Table'[Code])
			RETURN
			    CALCULATE(
			        SELECTEDVALUE('Code Descriptions'[DESCRIPTION], "No Description Found"),
			        'Code Descriptions'[Code] = TopCodeVal
			    )
		lineageTag: 77e89b19-6183-49a4-b4a5-9fe38031cbcc

