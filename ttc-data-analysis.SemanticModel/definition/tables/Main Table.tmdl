	column 'Incident Type' =
			
			IF(
			    'Main Table'[Min Delay] = 0 && 'Main Table'[Min Gap] = 0,
			    "Zero Delay & Gap",
			    "Service Impacted"
			)
		lineageTag: dce55070-a5bc-490a-b3e3-784de5df41b2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Main Table' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "assets\TTC Subway Delay Data since 2025.csv"),[Delimiter=",", Columns=11, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"_id", Int64.Type}, {"Date", type date}, {"Time", type time}, {"Day", type text}, {"Station", type text}, {"Code", type text}, {"Min Delay", Int64.Type}, {"Min Gap", Int64.Type}, {"Bound", type text}, {"Line", type text}, {"Vehicle", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Year", each 2025),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"Year", Int64.Type}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Changed Type1",{"_id", "Year", "Date", "Time", "Day", "Station", "Code", "Min Delay", "Min Gap", "Bound", "Line", "Vehicle"}),
				    #"Added Custom1" = Table.AddColumn(#"Reordered Columns", "Incident_id", each Text.From([Year]) & "-" & Text.From([_id])),
				    #"Reordered Columns1" = Table.ReorderColumns(#"Added Custom1",{"_id", "Incident_id", "Year", "Date", "Time", "Day", "Station", "Code", "Min Delay", "Min Gap", "Bound", "Line", "Vehicle"}),
				    #"Removed Columns" = Table.RemoveColumns(#"Reordered Columns1",{"Year", "_id"}),
				    #"Appended Query" = Table.Combine({#"Removed Columns", #"Delay Data 2024"}),
				    #"Sorted Rows" = Table.Sort(#"Appended Query",{{"Date", Order.Ascending}, {"Time", Order.Ascending}}),
				    #"Appended Query1" = Table.Combine({#"Sorted Rows", #"2023", #"2022", #"2021", #"2020"}),
				    #"Appended Query2" = Table.Combine({#"Appended Query1", #"2019"})
				in
				    #"Appended Query2"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

