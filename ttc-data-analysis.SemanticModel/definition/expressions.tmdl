expression ProjectFolder = "C:\Users\Mohit\Documents\ttc-data-analysis\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 37014af5-f98a-4e67-8a76-fb6c6de4f60c

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression fnImportFile =
		(fileName as text) as table =>
		let
		    FullPath = ProjectFolder & "assets\" & fileName,
		    Extension = Text.Lower(
		        Text.AfterDelimiter(
		            fileName,
		            ".",
		            {0, RelativePosition.FromEnd}
		        )
		    ),
		
		    Source =
		        if Extension = "csv" then
		            Table.PromoteHeaders(
		                Csv.Document(
		                    File.Contents(FullPath),
		                    [
		                        Delimiter = ",",
		                        Encoding = 65001,
		                        QuoteStyle = QuoteStyle.Csv
		                    ]
		                ),
		                [PromoteAllScalars = true]
		            )
		
		        else if Extension = "xlsx" then
		            Table.PromoteHeaders(
		                Excel.Workbook(
		                    File.Contents(FullPath),
		                    null,
		                    true
		                ){0}[Data],
		                [PromoteAllScalars = true]
		            )
		
		        else
		            error "Unsupported file type. Only .csv and .xlsx are supported."
		in
		    Source
	lineageTag: 2f4c442b-aba0-4c87-abfd-a599dfcd3bcf

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

